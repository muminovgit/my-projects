# --- Telegram ---
# @BotFather dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=
# Botni boshqara oladigan Telegram user ID'lar (vergul bilan). ID'ni bilish uchun botga /id yozing.
ADMIN_IDS=
# (ixtiyoriy) Bot admin qilingan kanallar ID'lari — ularning yangi postlari avtomatik olinadi
SOURCE_CHANNEL_IDS=
# (ixtiyoriy) true bo'lsa, kanal postlari tasdiq so'ramasdan joylanadi (baribir moderatsiyaga tushadi)
AUTO_PUBLISH=false

# --- Nexthome ---
# `npm run connect` buyrug'i bilan olinadi
NEXTHOME_MCP_TOKEN=
# NEXTHOME_MCP_URL=https://api.nexthome.uz/mcp

# --- Claude ---
# https://platform.claude.com dan olingan API kalit
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

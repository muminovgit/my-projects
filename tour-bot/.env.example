# BotFather bergan token. Hech kimga ko'rsatmang va chatga yozmang.
BOT_TOKEN=123456:replace-me
# Bron so'rovlari keladigan adminlar Telegram ID'lari (vergul bilan)
ADMIN_IDS=111111111
# SQLite (standart). PostgreSQL uchun: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///tour_bot.db
# AI yordamchi uchun Claude API kaliti (console.anthropic.com). Bo'sh qolsa, AI o'chiq bo'ladi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# (ixtiyoriy) Leadlar va bronlar keladigan Telegram guruh ID'si. Buning o'rniga guruhda /setgroup yozish ham mumkin.
ADMIN_GROUP_ID=
